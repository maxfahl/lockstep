// How Lockstep and the design lab are signed.
//
// By default both apps are signed to run locally on the Mac that builds them, so a fresh
// clone builds with Xcode alone, without an Apple developer account.
//
// To sign with your own team instead, create Config/Signing.local.xcconfig next to this
// file (git ignores it) with these two lines, your team id in place of the X's:
//
//     DEVELOPMENT_TEAM = XXXXXXXXXX
//     CODE_SIGN_IDENTITY = Apple Development
//
// macOS remembers the microphone permission per signature, so keep using the same way of
// signing for the copy you record with.

CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
